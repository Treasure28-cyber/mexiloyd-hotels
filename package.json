{
  "name": "mexiloyd-hotels",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/page-shells.mjs && vite build && vite build --ssr src/prerender.jsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "npm run build && npm run test && node scripts/verify-build.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "parse5": "^8.0.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
